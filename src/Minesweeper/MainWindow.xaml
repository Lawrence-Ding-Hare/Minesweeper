<Window
    x:Class="Minesweeper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Minesweeper.Controls">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======== 标题栏拖拽区（与工具栏一体，Mica 贯穿；无文字更简洁） ======== -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="32"
              Background="Transparent"
              PointerPressed="OnTitleBarPointerPressed">
            <TextBlock Text="扫雷" Margin="16,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Opacity="0.6"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- ======== 工具栏（透明背景，Mica 透出与标题栏一体；帮助按钮靠右） ======== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandBar Grid.Column="0"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsOpen="False"
                        Padding="0"
                        HorizontalAlignment="Left">
                <AppBarButton Icon="Refresh" Label="新游戏" Click="OnNewGameClick"
                              ToolTipService.ToolTip="快捷键 R" />
                <AppBarButton x:Name="UndoButton" Icon="Undo" Label="撤销" Click="OnUndoClick"
                              ToolTipService.ToolTip="撤销上一步操作（可后悔踩雷）" />
                <AppBarButton x:Name="HintButton" Icon="Bullets" Label="提示" Click="OnHintClick"
                              ToolTipService.ToolTip="快捷键 H：自动提示一个安全格" />

                <AppBarSeparator />

                <AppBarButton x:Name="DifficultyButton" Label="难度"
                              ToolTipService.ToolTip="选择难度或自定义棋盘">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE71B;" FontFamily="Segoe Fluent Icons" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton x:Name="ThemeButton" Label="主题"
                              ToolTipService.ToolTip="浅色 / 深色 / 跟随系统">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE790;" FontFamily="Segoe Fluent Icons" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <!-- 帮助按钮：独立 CommandBar（保证横排标签与左侧完全对齐），隐藏溢出按钮 -->
            <CommandBar Grid.Column="1" x:Name="HelpCommandBar"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsOpen="False"
                        OverflowButtonVisibility="Collapsed"
                        VerticalAlignment="Center">
                <AppBarButton x:Name="HelpButton" Icon="Help" Label="帮助"
                              ToolTipService.ToolTip="操作说明" />
            </CommandBar>
        </Grid>

        <!-- ======== 计数器区：剩余雷数 | 表情按钮 | 计时器 ======== -->
        <Grid Grid.Row="2" Padding="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 剩余雷数 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
                <FontIcon Glyph="&#xE7C1;" FontFamily="Segoe Fluent Icons"
                          FontSize="18" Foreground="{ThemeResource FlagBrush}" />
                <TextBlock x:Name="MinesRemainingText" Text="010" FontSize="20"
                           FontFamily="Consolas" FontWeight="SemiBold"
                           AutomationProperties.Name="剩余雷数" />
            </StackPanel>

            <!-- 表情按钮 -->
            <Button Grid.Column="1" x:Name="FaceButton"
                    Click="OnFaceButtonClick"
                    ToolTipService.ToolTip="点击重新开始"
                    AutomationProperties.Name="游戏状态，点击重新开始"
                    Padding="10,2"
                    BorderThickness="1">
                <TextBlock x:Name="FaceText" Text="😀" FontSize="26" FontFamily="Segoe UI Emoji" />
            </Button>

            <!-- 计时器 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="TimerText" Text="000" FontSize="20"
                           FontFamily="Consolas" FontWeight="SemiBold"
                           AutomationProperties.Name="用时" />
                <FontIcon Glyph="&#xE823;" FontFamily="Segoe Fluent Icons"
                          FontSize="18" />
            </StackPanel>
        </Grid>

        <!-- ======== 棋盘 ======== -->
        <controls:GameBoardControl x:Name="Board" Grid.Row="3" Margin="16,0,16,16" />

        <!-- ======== 状态条 ======== -->
        <InfoBar x:Name="StatusBar" Grid.Row="4" IsOpen="False"
                 IsClosable="True" Margin="16,0,16,16" />
    </Grid>
</Window>
