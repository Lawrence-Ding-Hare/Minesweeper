<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Minesweeper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用图标：嵌入 exe（免安装版资源管理器/任务栏图标） -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- 版本号（与 Package.appxmanifest 的 Identity Version 保持一致） -->
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Platforms>x64</Platforms>
    <!-- 打包要求明确架构，默认锁定 x64 避免 AnyCPU -->
    <Platform Condition="'$(Platform)'==''">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><DisableEmbeddedXbf>true</DisableEmbeddedXbf>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MSIX 单项目打包（纯 CLI 构建） -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>Minesweeper_TemporaryKey.pfx</PackageCertificateKeyFile>
    <AppxPackageDir>..\..\artifacts</AppxPackageDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(WindowsPackageType)' != 'None'">
    <AppxManifest Include="Package.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Minesweeper.Core\Minesweeper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
