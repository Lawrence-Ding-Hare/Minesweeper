<Application
    x:Class="Minesweeper.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 游戏资源（内联，避免外部 ResourceDictionary 引用） -->
            <ResourceDictionary.ThemeDictionaries>
                <!-- 浅色主题 -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MineNumber1Brush" Color="#FF1C4E80" />
                    <SolidColorBrush x:Key="MineNumber2Brush" Color="#FF2E7D32" />
                    <SolidColorBrush x:Key="MineNumber3Brush" Color="#FFC62828" />
                    <SolidColorBrush x:Key="MineNumber4Brush" Color="#FF4527A0" />
                    <SolidColorBrush x:Key="MineNumber5Brush" Color="#FF8E2400" />
                    <SolidColorBrush x:Key="MineNumber6Brush" Color="#FF00838F" />
                    <SolidColorBrush x:Key="MineNumber7Brush" Color="#FF000000" />
                    <SolidColorBrush x:Key="MineNumber8Brush" Color="#FF616161" />
                    <LinearGradientBrush x:Key="CellCoveredBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                        <GradientStop Offset="1" Color="#FFD9D9D9" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="CellCoveredBorderBrush" Color="#FF9E9E9E" />
                    <SolidColorBrush x:Key="CellRevealedBrush" Color="#FFD2D2D2" />
                    <SolidColorBrush x:Key="CellRevealedBorderBrush" Color="#FFB8B8B8" />
                    <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#26EDEDED" />
                    <SolidColorBrush x:Key="MineHitBrush" Color="#FFE57373" />
                    <SolidColorBrush x:Key="FlagBrush" Color="#FFC62828" />
                    <SolidColorBrush x:Key="QuestionBrush" Color="#FF1565C0" />
                    <SolidColorBrush x:Key="CursorBrush" Color="#FF0078D4" />
                    <AcrylicBrush x:Key="ToolbarAcrylicBrush"
                                  TintColor="#F3F3F3"
                                  TintOpacity="0.72"
                                  FallbackColor="#F3F3F3" />
                </ResourceDictionary>

                <!-- 深色主题 -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MineNumber1Brush" Color="#FF7CB9E8" />
                    <SolidColorBrush x:Key="MineNumber2Brush" Color="#FF81C784" />
                    <SolidColorBrush x:Key="MineNumber3Brush" Color="#FFE57373" />
                    <SolidColorBrush x:Key="MineNumber4Brush" Color="#FFB39DDB" />
                    <SolidColorBrush x:Key="MineNumber5Brush" Color="#FFFF8A65" />
                    <SolidColorBrush x:Key="MineNumber6Brush" Color="#FF4DD0E1" />
                    <SolidColorBrush x:Key="MineNumber7Brush" Color="#FFECEFF1" />
                    <SolidColorBrush x:Key="MineNumber8Brush" Color="#FFB0BEC5" />
                    <LinearGradientBrush x:Key="CellCoveredBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF5A5A5A" />
                        <GradientStop Offset="1" Color="#FF3A3A3A" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="CellCoveredBorderBrush" Color="#FF5F5F5F" />
                    <SolidColorBrush x:Key="CellRevealedBrush" Color="#FF2D2D2D" />
                    <SolidColorBrush x:Key="CellRevealedBorderBrush" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#261F1F1F" />
                    <SolidColorBrush x:Key="MineHitBrush" Color="#FFB71C1C" />
                    <SolidColorBrush x:Key="FlagBrush" Color="#FFFF6B6B" />
                    <SolidColorBrush x:Key="QuestionBrush" Color="#FF8AB4F8" />
                    <SolidColorBrush x:Key="CursorBrush" Color="#FF60CDFF" />
                    <AcrylicBrush x:Key="ToolbarAcrylicBrush"
                                  TintColor="#202020"
                                  TintOpacity="0.6"
                                  FallbackColor="#202020" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 菜单圆角样式（Win11 风格） -->
            <Style x:Key="RoundedMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0,4,0,4" />
                <Setter Property="MinWidth" Value="180" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
