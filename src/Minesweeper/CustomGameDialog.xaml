<ContentDialog
    x:Class="Minesweeper.CustomGameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="自定义难度"
    PrimaryButtonText="开始"
    CloseButtonText="取消"
    DefaultButton="Primary"
    CornerRadius="8">

    <StackPanel Spacing="16" Width="320" Margin="0,8,0,0">
        <TextBlock Text="设置棋盘尺寸与雷数（非法值自动修正）"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
        <NumberBox x:Name="WidthBox"
                   Header="宽度（列数）"
                   Minimum="3" Maximum="40"
                   Value="16" SmallChange="1"
                   SpinButtonPlacementMode="Compact"
                   AutomationProperties.Name="棋盘宽度" />
        <NumberBox x:Name="HeightBox"
                   Header="高度（行数）"
                   Minimum="3" Maximum="40"
                   Value="16" SmallChange="1"
                   SpinButtonPlacementMode="Compact"
                   AutomationProperties.Name="棋盘高度" />
        <NumberBox x:Name="MinesBox"
                   Header="雷数"
                   Minimum="1"
                   Value="40" SmallChange="1"
                   SpinButtonPlacementMode="Compact"
                   AutomationProperties.Name="雷数" />
    </StackPanel>
</ContentDialog>
